#. Plugin Name of the plugin
#: catavio.php
msgid "Catavio – Catalog Health for WooCommerce"
msgstr "Catavio – Katalog-Gesundheit für WooCommerce"

#. Plugin URI of the plugin
#: catavio.php
msgid "https://github.com/Safulislam/catavio"
msgstr ""

#. Description of the plugin
#: catavio.php
msgid "Find and fix common product information issues across your WooCommerce catalog from one simple dashboard."
msgstr ""
"Finde und behebe häufige Probleme mit Produktinformationen in deinem "
"gesamten WooCommerce-Katalog – alles aus einem einfachen Dashboard."

#. Author of the plugin
#: catavio.php
msgid "Saiful Islam"
msgstr "Saiful Islam"

#. Author URI of the plugin
#: catavio.php
msgid "https://profiles.wordpress.org/saiful09/"
msgstr ""

#: catavio.php:111
msgid "Catavio could not start because its autoloader is missing. Run \"composer install\" in the plugin directory, or install the packaged release."
msgstr ""
"Catavio konnte nicht gestartet werden, weil der Autoloader fehlt. Führe "
"„composer install“ im Plugin-Verzeichnis aus oder installiere das "
"fertige Release-Paket."

